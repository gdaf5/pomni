[gd_scene format=3]

[sub_resource type="GDScript" id="GDScript_Slash"]
script/source = "extends Node3D

@onready var anim_player: AnimationPlayer = $AnimationPlayer
@onready var mesh: MeshInstance3D = $MeshInstance3D

func _ready() -> void:
	if anim_player:
		anim_player.play(\"slash\")

func setup(is_heavy: bool, slash_color: Color = Color(0.1, 0.9, 1.0)) -> void:
	if mesh and mesh.material_override:
		var mat = mesh.material_override as StandardMaterial3D
		if mat:
			mat = mat.duplicate()
			mesh.material_override = mat
			mat.albedo_color = slash_color if not is_heavy else Color(1.0, 0.3, 0.1, 0.95)
	if is_heavy:
		scale = Vector3(1.6, 1.6, 1.6)
"

[sub_resource type="StandardMaterial3D" id="Mat_Slash"]
transparency = 1
cull_mode = 2
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(0.2, 0.9, 1, 0.9)

