[gd_scene load_steps=3 format=3]

[sub_resource type="GDScript" id="GDScript_DamageNumber"]
script/source = "extends Node3D

@onready var label: Label3D = $Label3D

func _ready() -> void:
	var tween = create_tween().set_parallel(true)
	tween.tween_property(self, \"position:y\", position.y + 1.2, 0.6).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	tween.tween_property(label, \"modulate:a\", 0.0, 0.6).set_delay(0.2)
	tween.chain().tween_callback(queue_free)

func setup(amount: float, is_heavy: bool) -> void:
	if not is_node_ready():
		await ready
	label.text = str(int(amount))
	if is_heavy:
		label.text += \"! CRIT\"
		label.modulate = Color(1.0, 0.25, 0.1, 1.0)
		label.font_size = 48
	else:
		label.modulate = Color(1.0, 0.9, 0.3, 1.0)
		label.font_size = 36
"

[node name="DamageNumber" type="Node3D"]
script = SubResource("GDScript_DamageNumber")

[node name="Label3D" type="Label3D" parent="."]
billboard = 1
double_sided = false
text = "25"
font_size = 36
outline_size = 8
outline_modulate = Color(0, 0, 0, 1)
