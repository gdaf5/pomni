[gd_scene load_steps=5 format=3]

[sub_resource type="StandardMaterial3D" id="Mat_Brass"]
albedo_color = Color(0.85, 0.65, 0.2, 1)
metallic = 0.8
roughness = 0.3

[sub_resource type="CylinderMesh" id="Mesh_Casing"]
height = 0.045
top_radius = 0.011
bottom_radius = 0.011

[sub_resource type="CylinderShape3D" id="Shape_Casing"]
height = 0.045
radius = 0.011

[sub_resource type="GDScript" id="GDScript_Casing"]
script/source = "extends RigidBody3D

func _ready() -> void:
	gravity_scale = 1.0
	angular_damp = 0.5
	linear_damp = 0.1
	
	apply_impulse(Vector3(randf_range(-0.8, 0.8), randf_range(1.5, 3.0), randf_range(-0.5, 0.5)).normalized() * randf_range(2.0, 4.0))
	apply_torque(Vector3(randf_range(-10, 10), randf_range(-10, 10), randf_range(-10, 10)))
	
	await get_tree().create_timer(3.0).timeout
	var mesh = get_node_or_null(\"MeshInstance3D\") as MeshInstance3D
	if mesh:
		var mat = mesh.material_override as StandardMaterial3D
		if mat:
			mat = mat.duplicate()
			mesh.material_override = mat
			var tween = create_tween()
			tween.tween_property(mat, \"albedo_color\", Color(mat.albedo_color.r, mat.albedo_color.g, mat.albedo_color.b, 0.0), 1.0)
			tween.finished.connect(queue_free)
		else:
			queue_free()
	else:
		queue_free()
"

[node name="ShellCasing" type="RigidBody3D"]
collision_layer = 0
collision_mask = 2
script = SubResource("GDScript_Casing")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
material_override = SubResource("Mat_Brass")
mesh = SubResource("Mesh_Casing")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("Shape_Casing")
