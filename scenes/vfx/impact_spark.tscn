[gd_scene load_steps=6 format=3]

[sub_resource type="StandardMaterial3D" id="Mat_Spark"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 0.7, 0.15, 1)

[sub_resource type="ParticleProcessMaterial" id="Proc_Spark"]
direction = Vector3(0, 1, 0)
spread = 70.0
initial_velocity_min = 3.0
initial_velocity_max = 8.0
gravity = Vector3(0, -12.0, 0)
scale_min = 0.03
scale_max = 0.12
dampening = 0.5

[sub_resource type="BoxMesh" id="Mesh_Spark"]
size = Vector3(0.06, 0.06, 0.06)

[sub_resource type="GDScript" id="GDScript_ImpactSpark"]
script/source = "extends Node3D

@onready var particles: GPUParticles3D = $GPUParticles3D

func _ready() -> void:
	if particles:
		particles.emitting = true
		await get_tree().create_timer(particles.lifetime + 0.1).timeout
		queue_free()

func setup(hit_color: Color = Color(1, 0.8, 0.2)) -> void:
	if particles and particles.material_override:
		var mat = particles.material_override as StandardMaterial3D
		if mat:
			mat = mat.duplicate()
			particles.material_override = mat
			mat.albedo_color = hit_color
		var pmat = particles.process_material as ParticleProcessMaterial
		if pmat:
			pmat.color = hit_color
"

[node name="ImpactSpark" type="Node3D"]
script = SubResource("GDScript_ImpactSpark")

[node name="GPUParticles3D" type="GPUParticles3D" parent="."]
material_override = SubResource("Mat_Spark")
emitting = true
amount = 12
lifetime = 0.3
one_shot = true
explosiveness = 0.9
process_material = SubResource("Proc_Spark")
draw_pass_1 = SubResource("Mesh_Spark")
