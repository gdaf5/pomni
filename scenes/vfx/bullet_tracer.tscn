[gd_scene load_steps=5 format=3]

[sub_resource type="StandardMaterial3D" id="Mat_Tracer"]
transparency = 1
shading_mode = 0
cull_mode = 2
vertex_color_use_as_albedo = true
albedo_color = Color(1, 0.85, 0.2, 1)

[sub_resource type="CylinderMesh" id="Mesh_Tracer"]
height = 1.0
top_radius = 0.03
bottom_radius = 0.03

[sub_resource type="Animation" id="Anim_Tracer"]
resource_name = "tracer"
length = 0.08
tracks/0/type = "value"
tracks/0/imported = false
tracks/0/enabled = true
tracks/0/path = NodePath("MeshInstance3D:material_override:albedo_color")
tracks/0/interp = 1
tracks/0/loop_wrap = true
tracks/0/keys = {
"times": PackedFloat32Array(0, 0.04, 0.08),
"transitions": PackedFloat32Array(1, 1, 1),
"update": 0,
"values": [Color(1, 0.9, 0.3, 1), Color(1, 0.7, 0.1, 0.6), Color(1, 0.4, 0, 0)]
}
tracks/1/type = "method"
tracks/1/imported = false
tracks/1/enabled = true
tracks/1/path = NodePath(".")
tracks/1/interp = 1
tracks/1/loop_wrap = true
tracks/1/keys = {
"times": PackedFloat32Array(0.08),
"transitions": PackedFloat32Array(1),
"values": [{
"args": [],
"method": &"queue_free"
}]
}

[sub_resource type="AnimationLibrary" id="AnimLib_Tracer"]
_data = {
"tracer": SubResource("Anim_Tracer")
}

[sub_resource type="GDScript" id="GDScript_Tracer"]
script/source = "extends Node3D

@onready var anim: AnimationPlayer = $AnimationPlayer
@onready var mesh: MeshInstance3D = $MeshInstance3D

func _ready() -> void:
	if anim:
		anim.play(\"tracer\")

func setup(start_pos: Vector3, end_pos: Vector3) -> void:
	var dir = (end_pos - start_pos).normalized()
	var dist = start_pos.distance_to(end_pos)
	global_position = start_pos + dir * (dist * 0.5)
	look_at(end_pos, Vector3.UP)
	rotate_x(-PI/2)  # Cylinder points along -Z by default
	if mesh:
		if mesh.mesh: mesh.mesh.height = dist
"

[node name="BulletTracer" type="Node3D"]
script = SubResource("GDScript_Tracer")

[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
material_override = SubResource("Mat_Tracer")
mesh = SubResource("Mesh_Tracer")

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries = {
"": SubResource("AnimLib_Tracer")
}
