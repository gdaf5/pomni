[gd_scene load_steps=6 format=3]

[sub_resource type="StandardMaterial3D" id="Mat_Sparks"]
transparency = 1
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 0.85, 0.2, 1)

[sub_resource type="ParticleProcessMaterial" id="ProcMat_Sparks"]
direction = Vector3(0, 1, 0)
spread = 60.0
initial_velocity_min = 4.0
initial_velocity_max = 8.0
gravity = Vector3(0, -9.8, 0)
scale_min = 0.05
scale_max = 0.15

[sub_resource type="BoxMesh" id="Mesh_Spark"]
size = Vector3(0.08, 0.08, 0.08)

[sub_resource type="GDScript" id="GDScript_HitParticles"]
script/source = "extends Node3D

@onready var particles: GPUParticles3D = $GPUParticles3D

func _ready() -> void:
	if particles:
		particles.emitting = true
		await get_tree().create_timer(particles.lifetime + 0.2).timeout
		queue_free()

func setup(is_heavy: bool, hit_color: Color = Color(1.0, 0.8, 0.2)) -> void:
	if particles and particles.process_material:
		var p_mat = particles.process_material as ParticleProcessMaterial
		if p_mat:
			p_mat.color = hit_color if not is_heavy else Color(1.0, 0.2, 0.1)
"

[node name="HitParticles" type="Node3D"]
script = SubResource("GDScript_HitParticles")

[node name="GPUParticles3D" type="GPUParticles3D" parent="."]
material_override = SubResource("Mat_Sparks")
emitting = true
amount = 18
lifetime = 0.4
one_shot = true
explosiveness = 0.9
process_material = SubResource("ProcMat_Sparks")
draw_pass_1 = SubResource("Mesh_Spark")
